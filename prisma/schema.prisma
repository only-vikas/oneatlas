datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

enum ProviderType {
  FIRST_PARTY
  INFERENCE_CLOUD
}

enum Modality {
  TEXT
  MULTIMODAL
  IMAGE
  EMBEDDING
}

enum ModelType {
  CHAT
  REASONING
  CODE
}

enum BenchmarkCategory {
  REASONING
  CODING
  GENERAL
  AGENTIC
}

model Lab {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  logoSlug     String
  description  String
  website      String
  headquarters String
  foundedYear  Int
  verified     Boolean  @default(true)
  models       Model[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([name])
}

model Provider {
  id          String                  @id @default(cuid())
  name        String
  slug        String                  @unique
  logoSlug    String
  type        ProviderType
  description String
  website     String
  regions     String[]
  slaTier     String
  uptime30d   Float
  endpoints   ModelProviderEndpoint[]
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@index([type])
}

model Model {
  id                 String                  @id @default(cuid())
  name               String
  slug               String                  @unique
  labId              String
  lab                Lab                     @relation(fields: [labId], references: [id], onDelete: Cascade)
  modality           Modality
  modelType          ModelType
  isOpenWeights      Boolean
  license            String
  contextWindow      Int
  maxOutputTokens    Int
  trainingCutoff     String
  capabilities       String[]
  supportsCaching    Boolean
  releaseDate        DateTime
  description        String
  compositeScore     Float
  rankCurrent        Int
  rankPrevious       Int
  usageDelta7d       Float
  sparkline7d        Float[]
  endpoints          ModelProviderEndpoint[]
  benchmarks         BenchmarkScore[]
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@index([labId])
  @@index([rankCurrent])
  @@index([compositeScore])
  @@index([modality])
  @@index([modelType])
}

model ModelProviderEndpoint {
  id                   String   @id @default(cuid())
  modelId              String
  model                Model    @relation(fields: [modelId], references: [id], onDelete: Cascade)
  providerId           String
  provider             Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  inputPricePer1M      Float
  outputPricePer1M     Float
  cacheInputPricePer1M Float?
  latencyMs            Int
  throughputTps        Int
  uptimePct            Float
  contextLimit         Int
  isDefault            Boolean
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([modelId, providerId])
  @@index([modelId])
  @@index([providerId])
  @@index([latencyMs])
  @@index([inputPricePer1M])
}

model BenchmarkScore {
  id            String            @id @default(cuid())
  modelId       String
  model         Model             @relation(fields: [modelId], references: [id], onDelete: Cascade)
  benchmarkName String
  category      BenchmarkCategory
  score         Float
  maxScore      Float
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([modelId, benchmarkName])
  @@index([modelId])
  @@index([category])
}
